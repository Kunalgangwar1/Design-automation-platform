# Copy to .env for local development. Never place real secrets in this file.
DATABASE_URL=postgresql+psycopg://design_user:local_password@localhost:5432/design_automation
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_local_password
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_QUERY_TIMEOUT_SECONDS=10
GRAPH_TRAVERSAL_DEPTH=1
GRAPH_DEGRADATION_ENABLED=true

LLM_PROVIDER_ORDER=openai,gemini
LLM_MAX_RETRY_ATTEMPTS=2
LLM_RETRY_DELAY_SECONDS=0.25
LLM_RETRY_JITTER_SECONDS=0.1
LLM_RETRY_MAX_DELAY_SECONDS=2.0

OPENAI_API_KEY=replace_with_openai_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_REASONING_EFFORT=low

GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=2000

RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300
RETRIEVAL_CACHE_MAX_ENTRIES=128
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_K=10
CONTEXT_DOCUMENT_LIMIT=5
MAX_REQUIREMENT_LENGTH=20000
LOG_LEVEL=INFO
